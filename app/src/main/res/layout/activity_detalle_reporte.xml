<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.DetalleReporteActivity">

    <!-- 1. Barra Superior -->
    <TextView
        android:id="@+id/txtTituloDetalle"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:drawableStart="@android:drawable/ic_menu_revert"
        android:drawablePadding="12dp"
        android:text="Reporte Detalle"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Tarjeta de Estadísticas (6 Indicadores del Mes) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEstadisticas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDetalle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Fila 1 de Estadísticas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Asistencias -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumAsistencias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="18"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asistencias"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>

                <!-- Entradas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumEntradas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="18"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entradas"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>

                <!-- Salidas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumSalidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="17"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Salidas"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <!-- Fila 2 de Estadísticas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Retardos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumRetardos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#D32F2F"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Retardos"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>

                <!-- Faltas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumFaltas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faltas"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>

                <!-- Reportes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumReportes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        tools:text="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reportes"
                        android:textSize="10sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Título de la Sección Detalle del Mes -->
    <TextView
        android:id="@+id/txtTituloDetalleMes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DETALLE DEL MES"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardEstadisticas"/>

    <!-- 4. RecyclerView para el listado diario -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetalleMes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDetalleMes"
        app:layout_constraintBottom_toTopOf="@id/layoutBotonesDescarga"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 5. Botones Inferiores de Descarga (PDF y Excel) -->
    <LinearLayout
        android:id="@+id/layoutBotonesDescarga"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDescargarPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Descargar PDF"
            android:textColor="@color/white"
            android:backgroundTint="#2E7D32"/>

        <Button
            android:id="@+id/btnDescargarExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Descargar Excel"
            android:textColor="#2E7D32"
            android:backgroundTint="@color/white"
            app:strokeColor="#2E7D32"
            app:strokeWidth="1dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>