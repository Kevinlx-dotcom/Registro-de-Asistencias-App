<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.JustificarActivity">

    <!-- Barra Superior -->
    <TextView
        android:id="@+id/txtTituloJustificar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Justificar"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tarjeta de Incidencias Pendientes -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPendiente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloJustificar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTES POR JUSTIFICAR (1)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <!-- Contenedor interno tipo alerta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF8E1"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtTipoFechaIncidencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retardo · 22 de octubre"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/txtHoraEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Entrada 07:08 h"
                    android:textSize="12sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="El plazo para justificar está pendiente de confirmación por la institución. Si no se justifica a tiempo, se considera falta."
                    android:textSize="11sp"
                    android:textColor="#795548" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Documentos Requeridos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPendiente">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOCUMENTOS PARA JUSTIFICAR UN RETARDO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#555555" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@android:drawable/checkbox_on_background"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="Documento requerido 1\nEjemplo: comprobante del motivo del retardo"
            android:textSize="12sp"
            android:textColor="#333333" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@android:drawable/checkbox_on_background"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="Documento requerido 2\nEjemplo: oficio de justificación firmado"
            android:textSize="12sp"
            android:textColor="#333333" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@android:drawable/checkbox_on_background"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="Documento requerido 3\nEjemplo: copia de identificación oficial"
            android:textSize="12sp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Entrega estos documentos en Administración dentro del plazo."
            android:textSize="11sp"
            android:textColor="#777777" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>